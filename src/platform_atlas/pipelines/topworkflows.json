{
  "name": "Top Run Workflows",
  "desc": "Show the top run workflows from the past 30 days",
  "collection": "jobs",
  "pipeline_version": "iapmetrics/1.0",
  "example": "platform-atlas session run report --operational",
  "pipeline": [
    {
      "$match": {
        "status": "complete",
        "$expr": {
          "$gte": [
            "$metrics.start_time",
            {
              "$subtract": [
                { "$toLong": "$$NOW" },
                2592000000
              ]
            }
          ]
        }
      }
    },
    {
      "$project": {
        "_id": 0,
        "name": 1,
        "run_time": {
          "$subtract": [
            {
              "$toLong": "$metrics.end_time"
            },
            {
              "$toLong": "$metrics.start_time"
            }
          ]
        }
      }
    },
    {
      "$group": {
        "_id": "$name",
        "Total Count": {
          "$sum": 1
        },
        "total_run_time": {
          "$sum": "$run_time"
        },
        "avg_run_time": {
          "$avg": "$run_time"
        },
        "run_times": {
          "$push": "$run_time"
        }
      }
    },
    {
      "$addFields": {
        "sorted_times": {
          "$sortArray": {
            "input": "$run_times",
            "sortBy": 1
          }
        }
      }
    },
    {
      "$project": {
        "_id": 0,
        "Workflow": "$_id",
        "Total Count": 1,
        "Total Runtime (minutes)": {
          "$round": [
            {
              "$divide": [
                "$total_run_time",
                60000
              ]
            },
            2
          ]
        },
        "Average Job Execution (minutes)": {
          "$round": [
            {
              "$divide": [
                "$avg_run_time",
                60000
              ]
            },
            2
          ]
        },
        "P95 (minutes)": {
          "$round": [
            {
              "$divide": [
                {
                  "$arrayElemAt": [
                    "$sorted_times",
                    {
                      "$floor": {
                        "$multiply": [
                          0.95,
                          {
                            "$subtract": [
                              {
                                "$size": "$sorted_times"
                              },
                              1
                            ]
                          }
                        ]
                      }
                    }
                  ]
                },
                60000
              ]
            },
            2
          ]
        },
        "P99 (minutes)": {
          "$round": [
            {
              "$divide": [
                {
                  "$arrayElemAt": [
                    "$sorted_times",
                    {
                      "$floor": {
                        "$multiply": [
                          0.99,
                          {
                            "$subtract": [
                              {
                                "$size": "$sorted_times"
                              },
                              1
                            ]
                          }
                        ]
                      }
                    }
                  ]
                },
                60000
              ]
            },
            2
          ]
        }
      }
    },
    {
      "$sort": {
        "Total Count": -1
      }
    },
    {
      "$limit": 25
    }
  ]
}
